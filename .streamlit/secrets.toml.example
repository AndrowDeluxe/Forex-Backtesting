# Vorlage fuer .streamlit/secrets.toml (gitignored, siehe .gitignore).
# Kopieren nach .streamlit/secrets.toml und mit den echten TradingView-Pro-
# Zugangsdaten fuellen -- diese Datei selbst bleibt ohne echte Werte und wird
# committet, damit die erwartete Struktur dokumentiert ist.

[tradingview]
username = "dein_tradingview_username"
password = "dein_tradingview_passwort"

[fred]
api_key = "dein_fred_api_key"
