{
  "schema_version": "1.0",
  "date_column": "date",
  "strategy_column": "strategy_return",
  "return_unit": "decimal",
  "frequency": "daily",
  "primary_model": {
    "name": "hold_NDX",
    "baseline_columns": [
      "base_return"
    ]
  },
  "sensitivity_models": [
    {
      "name": "base_plus_trend",
      "baseline_columns": [
        "base_return",
        "trend_return"
      ]
    }
  ],
  "regime_columns": [
    "regime"
  ],
  "rolling_window": 63,
  "minimum_observations": 60,
  "minimum_regime_observations": 20,
  "minimum_rolling_windows": 12,
  "hac_lags": "auto",
  "include_series": false,
  "data_declarations": {
    "baseline_selection": "predeclared",
    "strategy_return_basis": "net",
    "baseline_return_basis": "gross",
    "analysis_scope": "out_of_sample",
    "universe_data": "not_applicable"
  }
}